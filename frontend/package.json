{
  "name": "ko-community",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --no-ignore --deny-warnings src",
    "lint:css": "stylelint src/**/*.css --max-warnings 0",
    "quality:measure": "node scripts/measure-quality.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
